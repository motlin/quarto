ci := env("CI", "")

# `just --list --unsorted`
[group('default')]
default:
    @just --list --unsorted

# cargo build
[group('build')]
build:
    cargo build --all-targets

# cargo nextest run
[group('build')]
test:
    cargo nextest run {{ if ci != "" { "--profile ci" } else { "" } }}

# cargo clippy (all targets, warnings as errors)
[group('build')]
clippy:
    cargo clippy --all-targets --all-features -- -D warnings

# cargo fmt (--check in CI, fix locally)
[group('build')]
fmt:
    cargo fmt --all {{ if ci != "" { "-- --check" } else { "" } }}

# cargo deny check (advisories, licenses, bans, sources)
[group('build')]
deny:
    cargo deny check

# build + test + clippy + fmt + deny + coverage (mirrors the CI gate)
[group('build')]
check: build test clippy fmt deny coverage

# cargo llvm-cov (coverage; writes lcov.info in CI)
[group('build')]
coverage:
    cargo llvm-cov nextest {{ if ci != "" { "--lcov --output-path lcov.info" } else { "" } }}

# cargo run -- {{ARGS}}
[group('run')]
run *ARGS:
    cargo run -- {{ARGS}}

# Regenerate books/<rules>.bin (depth, lines|squares, threads); depth 4 takes about an hour on 16 cores
[group('run')]
book depth="4" rules="squares" threads=num_cpus():
    cargo run --release --bin book -- --depth {{ depth }} --rules {{ rules }} --threads {{ threads }} --out books/{{ rules }}.bin

# Lint the bindings, wasm-pack into ../web/src/solver/pkg, print the .wasm size, and smoke test it from node
[group('wasm')]
wasm:
    cargo clippy --lib --target wasm32-unknown-unknown --features wasm -- -D warnings
    wasm-pack build --target web --release --out-dir ../web/src/solver/pkg --out-name quarto_solver -- --features wasm
    @wc -c < ../web/src/solver/pkg/quarto_solver_bg.wasm | awk '{ printf "quarto_solver_bg.wasm: %.2f MB\n", $1 / 1048576 }'
    node ../scripts/wasm-smoke.mjs

# Regenerate depth 2 of both books and compare every record to the committed books (about half an hour)
[group('test')]
book-check:
    cargo nextest run --run-ignored only --no-fail-fast book_check

# Diff play transcripts of random games against the C++ reference (games, plies skipped, lines|squares)
[group('test')]
differential games="20" skip="8" rules="squares":
    ../scripts/differential.sh {{ games }} {{ skip }} {{ rules }}
