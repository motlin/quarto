{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	// Route files are loaded by the generated route tree, and the solver worker
	// is only referenced through `new Worker(new URL(...))`, so neither shows up
	// as a plain import. src/**/*.mdx mirrors the Storybook stories glob in
	// .storybook/main.ts; fallow's storybook plugin only detects *.stories.* files.
	"entry": ["src/main.tsx", "src/routes/**/*.tsx", "src/solver/solver.worker.ts", "src/**/*.mdx"],
	// routeTree.gen.ts is generated by @tanstack/router-plugin and src/solver/pkg
	// by wasm-pack; both are gitignored.
	"ignorePatterns": [".storybook/**", "src/routeTree.gen.ts", "src/solver/pkg/**"],
	// Tooling that never appears in an import: Storybook addons are named as
	// strings in .storybook/main.ts, @storybook/react-vite is imported from the
	// ignored .storybook/ directory, eslint-plugin-storybook and jiti are loaded
	// by vite.config.ts, @storybook/addon-docs is only imported from .mdx docs
	// pages, and wrangler is a CLI run by `just deploy` and the deploy workflows.
	"ignoreDependencies": [
		"@chromatic-com/storybook",
		"@storybook/addon-a11y",
		"@storybook/addon-docs",
		"@storybook/addon-onboarding",
		"@storybook/addon-vitest",
		"@storybook/react-vite",
		"eslint-plugin-storybook",
		"jiti",
		"wrangler",
	],
	"rules": {
		"unused-dependencies": "warn",
	},
}
