{
	"name": "quartobot-web",
	"version": "0.0.0",
	"private": true,
	"description": "QuartoBot: play Quarto against a perfect-play bot in the browser",
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"check": "vp check",
		"build": "vp build",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes",
		"fallow:ci": "fallow dead-code",
		"typecheck": "tsc --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"deploy": "wrangler pages deploy",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/ibm-plex-sans": "5.3.0",
		"@tanstack/react-router": "^1.170.27",
		"agentation": "^3.0.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.1",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-onboarding": "^10.6.0",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@tanstack/router-plugin": "^1.168.30",
		"@testing-library/react": "^16.3.3",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"eslint": "^10.10.0",
		"eslint-plugin-storybook": "^10.6.0",
		"fallow": "^3.22.0",
		"jiti": "^2.7.0",
		"jsdom": "^30.0.1",
		"markdownlint-cli2": "^0.23.2",
		"storybook": "^10.6.0",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.122.0"
	},
	"packageManager": "pnpm@12.4.1"
}
